# Used by demo/agent_groq.py. Never commit a real key.
# Choose the provider: groq (default) or openai. Or pass --provider on the command line.
LLM_PROVIDER=groq

# --- Groq (OpenAI-compatible endpoint) ---
GROQ_API_KEY=
# verify against current Groq docs: model names change
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenAI ---
OPENAI_API_KEY=
# verify against current OpenAI docs: the model must support tool/function calling
OPENAI_MODEL=gpt-4o-mini
# optional: a proxy or OpenAI-compatible server; leave empty for the default OpenAI endpoint
OPENAI_BASE_URL=
